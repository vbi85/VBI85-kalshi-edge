# Copy to .env and fill in. Never commit .env to GitHub.

# ---- Mode ----
# always start paper. Live is switched on from the dashboard after tests pass.
MODE=paper
# prod reads real prices. Use demo to smoke-test live orders with fake money.
KALSHI_ENV=prod

# ---- Kalshi API key (only needed for LIVE) ----
KALSHI_KEY_ID=
# e.g. /opt/kalshi-edge/kalshi_private_key.pem (only needed for LIVE)
KALSHI_PRIVATE_KEY_PATH=

# ---- Money rules ----
PAPER_BANKROLL=200
MAX_PER_TRADE=10
MAX_OPEN_EXPOSURE=60
# each strategy's own slice of the $60, so one can't starve the other
WEATHER_BUDGET=40
MENTIONS_BUDGET=20
DAILY_LOSS_LIMIT=20
# 8 cents of edge after fees, minimum
MIN_EDGE=0.08
# sell early when price rises 12 cents
TAKE_PROFIT=0.12
# skip when model and market disagree by more than 20 points (model likely wrong)
MAX_DISAGREE=0.20
# never bet NO on the market's single most likely bracket
NO_FADE_FAVORITE=true
# exits: at -15c re-check the model, exit unless 10c+ edge remains
STOP_LOSS=0.15
STOP_KEEP_EDGE=0.10
# blind hard stop: 0 = off (it cost $13 on Nov 10 by selling on normal swings)
HARD_STOP=0
# bets under 30c: max $3 stake, held to the result
CHEAP_PRICE=0.30
CHEAP_MAX_STAKE=3

# ---- Weather ----
# ALL = every mapped city (22). Or list codes: NYC,CHI,MIA,...
WEATHER_CITIES=ALL
# skip a city-day if the market's center and ours differ by more than this (wrong station guard)
MAX_MEAN_GAP=4.0

# ---- Which strategies run ----
ENABLED_STRATEGIES=weather,mentions

# ---- Mentions ----
# blank = auto-find mention series. Or list them: KXSERIES1,KXSERIES2
MENTION_SERIES=
# financial series are always skipped if their name contains any of these
MENTION_EXCLUDE=EARNINGS,EARN,FOMC,FED,POWELL,CEO,STOCK,CRYPTO,BITCOIN,BTC,ETH,DIVIDEND,SOLANA,INVEST,NASDAQ,DOW,SP500,TSLA,NVDA,AAPL,MSFT,AMZN,META,GOOG,TARIFFRATE
# need this many past events with the exact word before trading it
MENTION_MIN_HISTORY=4
# half size and a higher bar than weather
MENTION_MAX_PER_TRADE=5
MENTION_MIN_EDGE=0.10
# no new entries this close to the event, or after a 15c jump (event is live)
MENTION_MIN_HOURS=2
MENTION_MAX_MOVE=0.15

# ---- Go-live tests (each strategy must pass on its own) ----
GATE_MIN_DAYS=21
GATE_MIN_SETTLED=60
GATE_MIN_ROI=0.05
GATE_MAX_DRAWDOWN=0.25
# pick a 4-6 digit PIN; needed to flip to LIVE
LIVE_PIN=

# ---- Google Sheet log + email alerts (filled in by: bash deploy/set-alerts.sh) ----
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
ALERT_TZ=America/Chicago
# morning summary email at/after this hour
SUMMARY_HOUR=7

# ---- Dashboard login ----
DASH_USER=burt
DASH_PASSWORD=
DASH_PORT=8090
